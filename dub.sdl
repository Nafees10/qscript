name "qscript"
description "A Simple Scripting Language"
authors "Nafees Hassan"
copyright "Copyright © 2016-2026, Nafees Hassan"
license "MIT"
dependency "utils" version="~>0.9.0"
dependency "navm" version="3.2.0"
configuration "library" {
	targetType "library"
	targetName "qscript"
}
configuration "standalone" {
	targetType "executable"
	targetName "qscript"
	versions "qscriptstandalone"
}
